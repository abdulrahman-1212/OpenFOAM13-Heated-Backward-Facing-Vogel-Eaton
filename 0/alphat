FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    inlet       { type calculated; value uniform 0; }
    outlet      { type calculated; value uniform 0; }
    stepWall    { type compressible::alphatWallFunction; Prt 0.85; value uniform 0; }
    heatedWall  { type compressible::alphatWallFunction; Prt 0.85; value uniform 0; }
    topWall     { type compressible::alphatWallFunction; Prt 0.85; value uniform 0; }
    frontAndBack { type empty; }
}

