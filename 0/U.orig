FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet       { type fixedValue; value uniform (11.5 0 0); }
    outlet      { type zeroGradient; }
    stepWall    { type noSlip; }
    heatedWall  { type noSlip; }
    topWall     { type noSlip; }
    frontAndBack { type empty; }
}

// ************************************************************************* //
