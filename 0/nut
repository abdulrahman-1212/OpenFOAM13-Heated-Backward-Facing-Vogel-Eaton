FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 1.57e-4;

boundaryField
{
    inlet       { type calculated; value uniform 1.57e-4; }
    outlet      { type calculated; value uniform 1.57e-4; }
    stepWall    { type nutUSpaldingWallFunction; value uniform 0; }
    heatedWall  { type nutUSpaldingWallFunction; value uniform 0; }
    topWall     { type nutUSpaldingWallFunction; value uniform 0; }
    frontAndBack { type empty; }
}


