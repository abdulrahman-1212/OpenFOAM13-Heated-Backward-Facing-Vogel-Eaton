FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }
    "(U|h|e|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
    "rho.*"
    {
        solver          diagonal;
    }
}

PIMPLE
{
    nOuterCorrectors    1;
    nCorrectors         1;
    consistent          yes;
    momentumPredictor   yes;
}

relaxationFactors
{
    fields      { p 0.3; rho 0.05; }
    equations   { ".*" 0.7; }
}


